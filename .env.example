# PayProof environment — copy to .env
PORT=4000
HOST=127.0.0.1
API_KEY=pk_demo_dev

# Payment lifecycle windows
PAYMENT_WINDOW_MS=300000        # 5 minutes: customer must pay within this window
LATE_GRACE_MS=1800000           # 30 minutes: how far back we look for a "late match" suggestion

# Database: pglite (zero install) | postgres (set DATABASE_URL)
DB_DRIVER=pglite
PGLITE_DIR=./data/pgdata
# DATABASE_URL=postgres://payproof:payproof@localhost:5432/payproof

# Webhook delivery
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_BACKOFF_MS=1000,5000,25000,125000,600000,1800000
# WEBHOOK_TARGET=http://localhost:4000/webhook-sink

# scripts/demo.ts (stays up on this port)
DEMO_PORT=4100
